# Kopieren nach .env und bei Bedarf anpassen. Alle Werte sind optional.

# Port und Adresse des Servers. 127.0.0.1 = nur von diesem Computer erreichbar (empfohlen).
PORT=3000
HOST=127.0.0.1

# Lokale KI (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5

# Speicherort der SQLite-Datenbank
DB_PATH=./data/bewerbungen.db
